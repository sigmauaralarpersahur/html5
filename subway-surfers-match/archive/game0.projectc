[project]
title = SSM
version = 0.10.0
publisher = 
developer = 
write_log = 0
write_log_file = 0
minimum_log_level = 1
compress_archive = 1
custom_resources = custom_resources/
title_as_file_name = SSM

[display]
width = 1080
height = 1920
high_dpi = 1
samples = 0
fullscreen = 0
display_profiles = /assets/for_build/configs/custom.display_profilesc
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1
vsync = 1
variable_dt = 0
display_device_info = 0

[render]
clear_color_red = 0
clear_color_green = 0.654902
clear_color_blue = 0.909804
clear_color_alpha = 1

[physics]
max_collision_object_count = 128
type = 2D
use_fixed_timestep = 0
debug = 0
debug_alpha = 0.9
debug_scale = 30
world_count = 4
gravity_x = 0
gravity_y = -10
gravity_z = 0
scale = 1
allow_dynamic_transforms = 1
max_collisions = 64
max_contacts = 128
contact_impulse_limit = 0
ray_cast_limit_2d = 64
ray_cast_limit_3d = 128
trigger_overlap_capacity = 16
velocity_threshold = 1
max_fixed_timesteps = 2

[box2d]
velocity_iterations = 10
position_iterations = 10
sub_step_count = 4

[bootstrap]
main_collection = /collections/_loader/loader.collectionc
render = /modules/render/custom.renderc
debug_init_script = 

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 1024
max_characters = 8192
max_font_batches = 128
max_debug_vertices = 10000
texture_profiles = /assets/for_build/configs/custom.texture_profiles
verify_graphics_calls = 1
opengl_version_hint = 33
opengl_core_profile_hint = 1
memory_size = 512

[shader]
output_spirv = 0

[sound]
gain = 1
use_linear_gain = 1
max_sound_data = 128
max_sound_buffers = 32
max_sound_sources = 16
max_sound_instances = 256
max_component_count = 64
sample_frame_count = 0
use_thread = 1
stream_enabled = 0
stream_chunk_size = 16384
stream_preload_size = 16384
stream_cache_size = 2097152

[resource]
http_cache = 0
max_resources = 1024

[input]
repeat_delay = 0.5
repeat_interval = 0.2
gamepads = /builtins/input/default.gamepadsc
game_binding = /modules/input/game.input_bindingc
use_accelerometer = 1

[sprite]
max_count = 1024
subpixels = 1

[model]
max_count = 128
split_meshes = 0
max_bone_matrix_texture_width = 1024
max_bone_matrix_texture_height = 1024

[mesh]
max_count = 128

[gui]
max_count = 64
max_animation_count = 1024
max_particle_count = 1024
max_particlefx_count = 64

[collection]
max_instances = 2048
max_input_stack_entries = 16

[collection_proxy]
max_count = 16

[collectionfactory]
max_count = 128

[factory]
max_count = 128

[ios]
launch_screen = /builtins/manifests/ios/LaunchScreen.storyboardc
pre_renderered_icons = 0
bundle_identifier = example.unnamed
bundle_name = 
infoplist = /builtins/manifests/ios/Info.plist
privacymanifest = /builtins/manifests/ios/PrivacyInfo.xcprivacy
entitlements = 
default_language = en
localizations = en

[android]
version_code = 1
minimum_sdk_version = 19
target_sdk_version = 35
package = com.example.todo
gcm_sender_id = 
fcm_application_id = 
manifest = /builtins/manifests/android/AndroidManifest.xml
iap_provider = GooglePlay
input_method = HiddenInputField
immersive_mode = 0
display_cutout = 1
debuggable = 0
proguard = 
extract_native_libs = 0

[osx]
bundle_identifier = example.unnamed
bundle_name = 
bundle_version = 1
infoplist = /builtins/manifests/osx/Info.plist
privacymanifest = /builtins/manifests/osx/PrivacyInfo.xcprivacy
default_language = en
localizations = en

[windows]

[html5]
custom_heap_size = 0
heap_size = 90
htmlfile = /assets/for_build/preloader/engine_template.html
cssfile = /assets/for_build/preloader/light_theme.css
splash_image = /assets/for_build/preloader/ssm_logo.png
archive_location_prefix = archive
archive_location_suffix = 
engine_arguments = --verify-graphics-calls=false
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
scale_mode = stretch
transparent_graphics_context = 0

[particle_fx]
max_particle_count = 2048
max_particle_buffer_count = 2048
max_count = 528
max_emitter_count = 1024

[network]
http_timeout = 0
ssl_certificates = 
http_thread_count = 4
http_cache_enabled = 1

[library]
include_dirs = 

[script]
shared_state = 1

[label]
max_count = 64
subpixels = 1

[profiler]
track_cpu = 0
enabled = 1
sleep_between_server_updates = 0
performance_timeline_enabled = 0

[liveupdate]
enabled = 1
settings = /liveupdate.settings
mount_on_start = 1

[tilemap]
max_count = 16
max_tile_count = 2048

[engine]
run_while_iconified = 0
fixed_update_frequency = 60
max_time_step = 0.033333

[font]

[native_extension]
app_manifest = /assets/for_build/configs/generated.appmanifest

[spine]
max_count = 128

[druid]
no_auto_input = 0
no_stencil_check = 0
no_auto_template = 0
input_text = text
input_touch = click
input_marked_text = marked_text
input_key_esc = key_esc
input_key_back = key_back
input_key_enter = key_enter
input_key_backspace = key_backspace
input_multitouch = multitouch
input_scroll_up = scroll_up
input_scroll_down = scroll_down

[html_loader]
loader_main_color = rgba(0, 88, 187, 1)
loader_additional_color = rgba(0, 230, 247, 0.2)
loader_frame_color = rgba(255, 255, 255, 0)

